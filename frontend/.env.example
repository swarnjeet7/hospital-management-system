# Dev: leave unset so the app calls `/api/...` and Vite proxies to the backend (vite.config.js).
# Or set this to call the API directly (backend CORS must allow the Vite origin):
# VITE_API_BASE_URL=http://127.0.0.1:5000

# Production build: set your deployed API origin (no trailing slash).
# VITE_API_BASE_URL=https://api.yourdomain.com

# Optional: full URL to override login only
# VITE_LOGIN_ENDPOINT=http://127.0.0.1:5000/api/auth/login

# Optional: full URL to override register only
# VITE_REGISTER_ENDPOINT=http://127.0.0.1:5000/api/auth/register

# Used only by vite.config.js — where `/api` is proxied in dev (default http://127.0.0.1:5000)
# VITE_DEV_BACKEND_URL=http://127.0.0.1:5000
